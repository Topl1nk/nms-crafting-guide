# uv / Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Everything extracted or downloaded: .cache/game/ holds files unpacked and
# decompiled from the game install (`mise run extract`) and must never be
# committed; .cache/handbook/ is the NMS-Handbook fallback (`mise run fetch`).
# Only the normalised data/ output is committed.
.cache/
.cache/game/

# Generated by `mise run web-data`; the Pages workflow rebuilds them.
web/data.json
web/pdf/
web/img/
# ...and the markdown version of the site, written beside it by the same export.
web/md/
web/llms.txt
web/llms-full.txt
web/sitemap.xml
web/robots.txt

# The Svelte site: npm packages, and the build `mise run web-build` deploys.
node_modules/
dist/
