#!/usr/bin/env bash
#MISE description="Check, push main over SSH, and follow the Pages deploy it triggers"
set -euo pipefail
repo=rdlu/nms-items-interface

# Refuse before the slow part: only a clean main is ever deployed, and only
# over SSH (never an HTTPS remote that would fall back to a token).
[[ $(git branch --show-current) == main ]] || { echo 'deploy pushes main - switch to it first' >&2; exit 1; }
[[ -z $(git status --porcelain) ]] || { echo 'uncommitted changes - commit or stash them first' >&2; exit 1; }
remote=$(git remote get-url --push origin)
case $remote in
  git@*|ssh://*) ;;
  *) echo "origin pushes to $remote - deploy only pushes over SSH" >&2; exit 1 ;;
esac

mise run check

sha=$(git rev-parse HEAD)
git push origin main

# Follow the Pages run for this commit. GitHub takes a moment to list it, so
# wait for it rather than picking up the previous run.
run=
for _ in $(seq 30); do
  run=$(gh run list -R "$repo" -w pages.yml -c "$sha" -L 1 --json databaseId -q '.[0].databaseId // empty')
  [[ -n $run ]] && break
  sleep 2
done
[[ -n $run ]] || { echo "no Pages run for ${sha:0:7} after 60s: gh run list -R $repo -w pages.yml" >&2; exit 1; }
gh run watch -R "$repo" --exit-status "$run"
