/* Every colour is a theme variable, so Ctrl+P > Theme repaints all of it.
   The roles: $background behind the tables, $surface for the panes and
   notes beside them, $panel for input boxes and pane titles, a lighter
   $panel for dividers and the cursor row. Default theme: dracula-clear
   (themes.py), where background and surface are the terminal's own. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $surface;
    color: $primary;
}

Footer {
    background: $surface;
}

#search {
    border: tall $panel-lighten-1;
    background: $panel;
    margin: 0 1;
}

#search:focus {
    border: tall $primary;
}

#filter-note {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $surface;
}

#body {
    height: 1fr;
}

DataTable {
    width: 2fr;
    height: 100%;
    background: $background;
}

DataTable > .datatable--cursor {
    background: $panel-lighten-1;
    color: $warning;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

#detail {
    width: 1fr;
    min-width: 34;
    height: 100%;
    border-left: solid $panel-lighten-1;
    padding: 1 2;
    background: $surface;
    overflow-y: auto;
}

/* --- chain screen --- */

#chain-summary {
    height: auto;
    padding: 1 2;
    background: $surface;
    border-bottom: solid $panel-lighten-1;
}

Tree {
    background: $background;
    padding: 1 2;
}

/* --- nanite screen --- */

#nanite-note {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
}

#nanite-table {
    width: 100%;
    height: 1fr;
}

#nanite-detail {
    height: auto;
    min-height: 4;
    padding: 1 2;
    background: $surface;
    border-top: solid $panel-lighten-1;
}

/* --- food screen --- */

#food-note {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
}

#food-body {
    height: 1fr;
}

#food-left {
    width: 66;
    border-right: solid $panel-lighten-1;
}

#food-right {
    width: 1fr;
}

#food-detail {
    height: auto;
    min-height: 5;
    padding: 1 2;
    background: $surface;
    border-top: solid $panel-lighten-1;
}

/* --- storage screen --- */

#store-search {
    border: tall $panel-lighten-1;
    background: $panel;
    margin: 0 1;
}

#store-search:focus {
    border: tall $success;
}

#store-body {
    height: 1fr;
}

#store-table {
    width: 92;
    height: 100%;
}

#store-detail {
    width: 1fr;
    min-width: 30;
    height: 100%;
    border-left: solid $panel-lighten-1;
    padding: 1 2;
    background: $surface;
    overflow-y: auto;
}

/* --- inventory screen --- */

#inv-body {
    height: 1fr;
}

#inv-list {
    width: 1fr;
    border-right: solid $panel-lighten-1;
}

#inv-right {
    /* Even split: the carried list has a "Goes to" column to fit now. */
    width: 1fr;
}

#inv-add {
    border: tall $panel-lighten-1;
    background: $panel;
    margin: 0 1;
}

#inv-add:focus {
    border: tall $success;
}

.pane-title {
    padding: 0 2;
    background: $panel;
    color: $primary;
    text-style: bold;
    height: 1;
}

/* --- multi-tool screen --- */

#mt-headline {
    height: auto;
    padding: 0 2;
    background: $surface;
}

/* Without this the tab body sizes to its content and pushes the headline off
   the top of the screen. */
#mt-tabs {
    height: 1fr;
}

#type-table, #weapon-table {
    height: 1fr;
    width: 100%;
}

#type-detail, #weapon-detail {
    height: auto;
    min-height: 3;
    padding: 1 2;
    background: $surface;
    border-top: solid $panel-lighten-1;
}

#mt-getting, #mt-tips {
    padding: 1 2;
    height: auto;
}

/* --- modal --- */

QuantityModal {
    align: center middle;
}

#modal-box {
    width: 52;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#modal-title {
    height: auto;
    padding-bottom: 1;
}

HelpScreen {
    align: center middle;
}

#help-box {
    width: 74;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
    overflow-y: auto;
}

/* --- portal screen --- */

#portal-input {
    border: tall $panel-lighten-1;
    background: $panel;
    margin: 0 1;
}

#portal-input:focus {
    border: tall $accent;
}

#portal-body {
    height: 1fr;
}

/* Wide enough for the glyph grid: four "12 dragonfly F" cells across. */
#portal-left {
    width: 62;
    min-width: 40;
    padding: 1 2;
    background: $surface;
    border-right: solid $panel-lighten-1;
}

/* No second pane, no divider. */
#portal-left.-solo {
    border-right: none;
}

#portal-right {
    width: 1fr;
}

#loc-table {
    height: 1fr;
    width: 100%;
}

#loc-detail {
    height: auto;
    min-height: 6;
    padding: 1 2;
    background: $surface;
    border-top: solid $panel-lighten-1;
}

LocationModal {
    align: center middle;
}

GlyphPickerModal {
    align: center middle;
}

/* Eight 12-column cells ("8 dragonfly" plus a gap), padding and border. */
#picker-box {
    width: 102;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#picker-code {
    height: auto;
    padding-bottom: 1;
}

#picker-grid {
    height: auto;
}

.picker-row {
    height: auto;
}

.glyph-cell {
    width: 12;
    height: auto;
    padding: 0 1 0 0;
    margin: 0 0 1 0;
}

.glyph-cell:hover {
    background: $panel;
}

.glyph-cell.-cursor {
    background: $panel-lighten-1;
    color: $warning;
}

#loc-modal-box {
    width: 66;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

.loc-field {
    height: 1;
    margin-bottom: 1;
}

.loc-label {
    width: 9;
    color: $primary;
}

#loc-modal-box Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: $panel;
}

#loc-modal-box Input:focus {
    background: $panel-lighten-1;
    color: $warning;
}

/* Empty until something is wrong, so it takes no room until it does. */
#loc-error {
    height: auto;
    padding: 0 10;
}
